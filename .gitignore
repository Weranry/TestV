# 运行数据：数据库里有账号口令哈希与全部 evkey（明文），以及备份/上传产物。
# 这些文件绝不能进版本库，一次 `git add .` 就会把整套凭据带走。
data/

# Python 运行产物
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/

# SQLite 旁挂文件（直接放在仓库根时也要挡住）
*.db-wal
*.db-shm
*.db-journal

# 本地环境与密钥
.env
.env.*
!.env.example
.venv/
venv/
env/

# 编辑器 / 系统文件
.idea/
.vscode/
.trae/
.DS_Store
Thumbs.db

# 截图与临时产物
.screenshots/
*.log
